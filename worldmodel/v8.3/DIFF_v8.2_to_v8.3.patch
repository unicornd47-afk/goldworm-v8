+def test_sidecar_samples_fields_and_stops_with_pid(tmp_path):
+    sc = _sidecar()
+    child = subprocess.Popen([sys.executable, "-c", "import time; t=time.time()\nwhile time.time()-t<0.6: pass"])
+    out = str(tmp_path / "LOAD.txt")
