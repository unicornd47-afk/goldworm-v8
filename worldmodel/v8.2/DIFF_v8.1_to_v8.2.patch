+def test_infeasible_fallback_lowest_D():
+    tab = {(32, 0.5): _t(10.0, 0.40), (32, 0.875): _t(2.0, 0.90), (64, 1.0): _t(9.0, 0.35), (96, 0.5): _t(8.0, 0.35)}
+    sel, feas = ST.select_within_arm("GRU", tab, DMAX)
