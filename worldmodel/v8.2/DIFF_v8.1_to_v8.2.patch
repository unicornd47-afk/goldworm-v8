+# ---------------- E1.6 flag-only fallback ----------------
+def _sel(wm, gru, lin, rc):
+    return {"WM": dict(feasible=wm), "GRU": dict(feasible=gru), "LIN": dict(feasible=lin), "RC_only": dict(feasible=rc)}
