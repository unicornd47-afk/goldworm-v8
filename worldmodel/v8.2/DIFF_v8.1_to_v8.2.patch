+# ---------------- within-arm selection ----------------
+def test_feasible_min_energy():
+    tab = {(32, 0.5): _t(10.0, 0.10), (32, 0.875): _t(6.0, 0.50), (64, 0.625): _t(8.0, 0.30), (96, 0.75): _t(7.0, 0.32)}
+    assert ST.select_within_arm("GRU", tab, DMAX) == ((96, 0.75), True)
