+    assert ST.select_comparator(sel) == "RC_only"                               # order RC_only, LIN, GRU
+    sel = {"GRU": _s(4.0, 0.5, False), "LIN": _s(3.0, 0.5, False), "RC_only": _s(3.0, 0.5, False)}
